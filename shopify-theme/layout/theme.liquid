<!DOCTYPE html>
<html lang="{{ request.locale.iso_code | default: 'fr' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <!-- Title -->
  <title>
    {%- if template == 'index' -%}
      HOKUNO ホクノ — Streetwear Manga Japonais
    {%- elsif page_title -%}
      {{ page_title }} — HOKUNO ホクノ
    {%- else -%}
      HOKUNO ホクノ
    {%- endif -%}
  </title>

  <!-- Meta description -->
  <meta name="description" content="{% if template == 'index' %}Hokuno (ホクノ) — Marque streetwear manga française. T-shirts, mugs et accessoires avec des designs originaux inspirés de l'univers manga. Livraison internationale.{% elsif page_description != blank %}{{ page_description | strip_html | truncate: 155 }}{% else %}HOKUNO — ホクノ — Streetwear manga japonais. Toujours aller de l'avant.{% endif %}">

  <!-- Noindex on non-indexable pages -->
  {% if template == 'cart' or template == 'search' or template contains 'customers' %}
    <meta name="robots" content="noindex, nofollow">
  {% endif %}

  <!-- Canonical -->
  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Hreflang -->
  {% if request.locale %}
    {% for locale in shop.published_locales %}
      <link rel="alternate" hreflang="{{ locale.iso_code }}" href="{{ canonical_url | replace: request.locale.root_url, locale.root_url }}">
    {% endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ canonical_url | replace: request.locale.root_url, '/' }}">
  {% endif %}

  <!-- Open Graph -->
  <meta property="og:site_name" content="HOKUNO ホクノ">
  <meta property="og:url" content="{{ canonical_url }}">
  {% if template == 'product' %}
    <meta property="og:type" content="product">
    <meta property="og:title" content="{{ product.title }} — HOKUNO ホクノ">
    <meta property="og:description" content="{{ product.description | strip_html | truncate: 200 }}">
    <meta property="og:image" content="{{ product.featured_image | image_url: width: 1200 }}">
    <meta property="product:price:amount" content="{{ product.price | money_without_currency }}">
    <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  {% elsif template == 'article' %}
    <meta property="og:type" content="article">
    <meta property="og:title" content="{{ article.title }} — HOKUNO ホクノ">
    <meta property="og:description" content="{{ article.excerpt_or_content | strip_html | truncate: 200 }}">
    {% if article.image %}<meta property="og:image" content="{{ article.image | image_url: width: 1200 }}">{% endif %}
  {% elsif template == 'collection' %}
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ collection.title }} — HOKUNO ホクノ">
    <meta property="og:description" content="{{ collection.description | strip_html | truncate: 200 }}">
    <meta property="og:image" content="{{ collection.handle | prepend: 'card-' | append: '.png' | asset_url }}">
  {% else %}
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ page_title | default: 'HOKUNO ホクノ' }}">
    <meta property="og:description" content="{{ page_description | default: 'HOKUNO — ホクノ — Streetwear manga japonais.' | strip_html | truncate: 200 }}">
    <meta property="og:image" content="{{ 'hero-tshirt.png' | asset_url }}">
  {% endif %}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | default: 'HOKUNO ホクノ' }}">
  <meta name="twitter:description" content="{{ page_description | default: 'Streetwear manga japonais' | strip_html | truncate: 200 }}">
  {% if template == 'product' %}
    <meta name="twitter:image" content="{{ product.featured_image | image_url: width: 1200 }}">
  {% elsif template == 'article' and article.image %}
    <meta name="twitter:image" content="{{ article.image | image_url: width: 1200 }}">
  {% else %}
    <meta name="twitter:image" content="{{ 'hero-tshirt.png' | asset_url }}">
  {% endif %}

  <!-- Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" as="style">
  {% if template == 'index' %}
    <link rel="preload" href="{{ 'hero-tshirt.png' | asset_url }}" as="image">
  {% endif %}

  <!-- Fonts -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap">

  <!-- Theme CSS -->
  <link rel="stylesheet" href="{{ 'hokuno.css' | asset_url }}">

  <!-- Favicon -->
  {% if settings.favicon %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {% endif %}

  <!-- JSON-LD schemas -->
  {% render 'seo-jsonld' %}

  <!-- Analytics config -->
  <script>
    window.hokuno_ga4_id = {{ settings.ga4_id | json }};
    window.hokuno_meta_pixel_id = {{ settings.meta_pixel_id | json }};
    window.hokuno_tiktok_pixel_id = {{ settings.tiktok_pixel_id | json }};
    window.hokuno_free_shipping_threshold = 6000;
  </script>

  {{ content_for_header }}
</head>

<body class="template-{{ template | replace: '/', '-' | replace: '.', '-' | strip }}">

  <!-- ============================================================
       NAVBAR
       ============================================================ -->
  <nav class="nav" role="navigation" aria-label="Navigation principale">
    <div class="nav-inner">

      <a href="/" class="nav-logo" aria-label="HOKUNO — Accueil">
        <img
          src="{{ 'logo-hokuno-transparent.png' | asset_url }}"
          alt="HOKUNO"
          class="nav-logo-img"
          width="130"
          height="65">
      </a>

      <ul class="nav-links" role="list">
        <li>
          <a href="/collections" class="nav-link{% if template == 'list-collections' or template == 'collection' %} nav-active{% endif %}">
            {{ 'nav.collections' | t }}
          </a>
        </li>
        <li>
          <a href="/collections/all?sort_by=created-descending" class="nav-link">
            {{ 'nav.new_arrivals' | t }}
          </a>
        </li>
        <li>
          <a href="/pages/about" class="nav-link{% if template == 'page' and page.handle == 'about' %} nav-active{% endif %}">
            {{ 'nav.about' | t }}
          </a>
        </li>
        <li>
          <a href="/blogs/journal" class="nav-link{% if template == 'blog' or template == 'article' %} nav-active{% endif %}">
            {{ 'nav.journal' | t }}
          </a>
        </li>
      </ul>

      <div class="nav-right">
        <div class="lang-selector" role="group" aria-label="Langue">
          {% if request.locale.iso_code == 'fr' %}
            <span class="lang-active">FR</span>
            <span class="lang-sep">|</span>
            <a href="/en{{ request.path }}" class="lang-link">EN</a>
          {% else %}
            <a href="/fr{{ request.path }}" class="lang-link">FR</a>
            <span class="lang-sep">|</span>
            <span class="lang-active">EN</span>
          {% endif %}
        </div>

        <a href="/search" class="nav-action" aria-label="{{ 'nav.search' | t }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </a>

        <a href="/account" class="nav-action" aria-label="{{ 'nav.account' | t }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>

        <a href="/cart" class="nav-action nav-cart" aria-label="{{ 'nav.cart' | t }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <span class="cart-count" {% if cart.item_count == 0 %}style="display:none"{% endif %}>{{ cart.item_count }}</span>
        </a>

        <button class="nav-hamburger" id="menu-toggle" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </nav>

  <!-- ============================================================
       MOBILE MENU OVERLAY
       ============================================================ -->
  <div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu de navigation">
    <button class="mobile-menu-close" id="mobile-menu-close" aria-label="Fermer le menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <nav class="mobile-menu-nav" aria-label="Menu mobile">
      <a href="/collections" class="mobile-menu-link{% if template == 'list-collections' or template == 'collection' %} active{% endif %}">{{ 'nav.collections' | t }}</a>
      <a href="/collections/all?sort_by=created-descending" class="mobile-menu-link">{{ 'nav.new_arrivals' | t }}</a>
      <a href="/pages/about" class="mobile-menu-link{% if template == 'page' and page.handle == 'about' %} active{% endif %}">{{ 'nav.about' | t }}</a>
      <a href="/blogs/journal" class="mobile-menu-link{% if template == 'blog' or template == 'article' %} active{% endif %}">{{ 'nav.journal' | t }}</a>
      <a href="/search" class="mobile-menu-link">{{ 'nav.search' | t }}</a>
      <a href="/account" class="mobile-menu-link{% if template contains 'customers' %} active{% endif %}">{{ 'nav.account' | t }}</a>
    </nav>
    <div class="mobile-menu-lang">
      {% if request.locale.iso_code == 'fr' %}
        <span class="lang-active">FR</span>
        <span class="lang-sep">|</span>
        <a href="/en{{ request.path }}" class="lang-link">EN</a>
      {% else %}
        <a href="/fr{{ request.path }}" class="lang-link">FR</a>
        <span class="lang-sep">|</span>
        <span class="lang-active">EN</span>
      {% endif %}
    </div>
  </div>

  <!-- ============================================================
       CART NOTIFICATION
       ============================================================ -->
  <div class="cart-notification" id="cart-notification" role="status" aria-live="polite">
    <span class="cart-notif-title">{{ 'product.cart_notification' | t }}</span>
    <button class="cart-notif-close" aria-label="Fermer">&times;</button>
  </div>

  <!-- ============================================================
       PAGE CONTENT
       ============================================================ -->
  {{ content_for_layout }}

  <!-- ============================================================
       FOOTER
       ============================================================ -->
  <footer class="foot" role="contentinfo">
    <div class="foot-inner">
      <div class="foot-grid">

        <div class="foot-col foot-col--brand">
          <a href="/" aria-label="HOKUNO — Accueil">
            <img src="{{ 'logo-hokuno-transparent.png' | asset_url }}" alt="HOKUNO" class="foot-logo" width="120" height="60" loading="lazy">
          </a>
          <p class="foot-tagline">{{ 'footer.tagline' | t }}</p>
          <div class="foot-social">
            <a href="https://www.tiktok.com/@hokuno" class="foot-social-link" aria-label="TikTok Hokuno" rel="noopener noreferrer" target="_blank">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.32 6.32 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.73a8.14 8.14 0 004.77 1.52V6.82a4.85 4.85 0 01-1-.13z"/></svg>
            </a>
            <a href="https://www.instagram.com/hokuno" class="foot-social-link" aria-label="Instagram Hokuno" rel="noopener noreferrer" target="_blank">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
          </div>
        </div>

        <div class="foot-col">
          <h5 class="foot-col-title">{{ 'footer.col_collections' | t }}</h5>
          <ul class="foot-links" role="list">
            <li><a href="/collections/wanted" class="foot-link">Wanted</a></li>
            <li><a href="/collections/direction" class="foot-link">Direction</a></li>
            <li><a href="/collections/mythologie" class="foot-link">Mythologie</a></li>
            <li><a href="/collections/design-hokuno" class="foot-link">Design Hokuno</a></li>
          </ul>
        </div>

        <div class="foot-col">
          <h5 class="foot-col-title">{{ 'footer.col_information' | t }}</h5>
          <ul class="foot-links" role="list">
            <li><a href="/pages/about" class="foot-link">{{ 'nav.about' | t }}</a></li>
            <li><a href="/pages/faq" class="foot-link">FAQ</a></li>
            <li><a href="/pages/contact" class="foot-link">Contact</a></li>
            <li><a href="/blogs/journal" class="foot-link">{{ 'nav.journal' | t }}</a></li>
          </ul>
        </div>

        <div class="foot-col">
          <h5 class="foot-col-title">{{ 'footer.col_legal' | t }}</h5>
          <ul class="foot-links" role="list">
            <li><a href="/policies/terms-of-service" class="foot-link">{{ 'footer.terms' | t }}</a></li>
            <li><a href="/policies/privacy-policy" class="foot-link">{{ 'footer.privacy' | t }}</a></li>
            <li><a href="/policies/refund-policy" class="foot-link">{{ 'footer.refunds' | t }}</a></li>
            <li><a href="/pages/mentions-legales" class="foot-link">{{ 'footer.legal_notice' | t }}</a></li>
          </ul>
        </div>
      </div>

      <div class="foot-newsletter">
        {% render 'newsletter-form' %}
      </div>

      <p class="foot-copy">{{ 'footer.copyright' | t }}</p>
    </div>
  </footer>

  <!-- ============================================================
       BOTTOM NAV MOBILE
       ============================================================ -->
  <nav class="mobile-nav" role="navigation" aria-label="Navigation rapide">
    <a href="/" class="mobile-nav-item{% if template == 'index' %} active{% endif %}" aria-label="{{ 'nav.home' | t }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span class="mobile-nav-label">{{ 'nav.home' | t }}</span>
    </a>
    <a href="/collections" class="mobile-nav-item{% if template == 'collection' or template == 'list-collections' %} active{% endif %}" aria-label="{{ 'nav.collections' | t }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h6"/><path d="M16 12h6"/><path d="M16 16h6"/></svg>
      <span class="mobile-nav-label">{{ 'nav.collections' | t }}</span>
    </a>
    <a href="/cart" class="mobile-nav-item mobile-nav-cart{% if template == 'cart' %} active{% endif %}" aria-label="{{ 'nav.cart' | t }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      {% if cart.item_count > 0 %}<span class="cart-badge cart-count">{{ cart.item_count }}</span>{% endif %}
      <span class="mobile-nav-label">{{ 'nav.cart' | t }}</span>
    </a>
    <a href="/account" class="mobile-nav-item{% if template contains 'customers' %} active{% endif %}" aria-label="{{ 'nav.account' | t }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      <span class="mobile-nav-label">{{ 'nav.account' | t }}</span>
    </a>
  </nav>

  <!-- ============================================================
       COOKIE BANNER
       ============================================================ -->
  <div class="cookie-banner" id="cookie-banner" role="dialog" aria-label="Consentement cookies" style="display:none">
    <div class="cookie-banner-content">
      <p class="cookie-text">
        {{ 'cookie.text' | t }}
        <a href="/policies/privacy-policy" class="cookie-learn-more">{{ 'cookie.learn_more' | t }}</a>
      </p>
      <div class="cookie-actions">
        <button class="btn-ghost cookie-btn" onclick="refuseCookies()">{{ 'cookie.refuse' | t }}</button>
        <button class="btn-gold cookie-btn" onclick="acceptCookies()">{{ 'cookie.accept' | t }}</button>
      </div>
    </div>
  </div>

  <!-- Back to top -->
  <button class="back-to-top" id="back-to-top" aria-label="Retour en haut de page">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
  </button>

  <script src="{{ 'hokuno.js' | asset_url }}" defer></script>

</body>
</html>
