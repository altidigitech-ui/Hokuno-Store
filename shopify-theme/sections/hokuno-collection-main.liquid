<div class="hk-collection">
  <div class="hk-container">

    <div class="hk-collection-hero hk-reveal">
      <div class="hk-collection-hero-inner">
        <div>
          <span class="hk-label" style="display: block; margin-bottom: 8px;">Collection</span>
          <h1 class="hk-collection-title" itemprop="name">{{ collection.title }}</h1>
        </div>
        <span class="hk-collection-count">{{ collection.products_count }} produits</span>
      </div>
      {%- if collection.description != blank -%}
        <p style="color: var(--hk-gray); font-size: 0.92rem; line-height: 1.6; max-width: 600px; margin: 20px 0 0;" itemprop="description">
          {{ collection.description }}
        </p>
      {%- endif -%}
    </div>

    <div class="hk-collection-filters" role="navigation" aria-label="Filtres">
      <button class="hk-filter-tag active" data-filter="all">Tout</button>
      <button class="hk-filter-tag" data-filter="light">Light</button>
      <button class="hk-filter-tag" data-filter="dark">Dark / Noir</button>
      <button class="hk-filter-tag" data-filter="tshirt">T-Shirts</button>
      <button class="hk-filter-tag" data-filter="mug">Mugs</button>
      <button class="hk-filter-tag" data-filter="accessoire">Accessoires</button>
    </div>

    <div class="hk-products-grid" itemscope itemtype="https://schema.org/CollectionPage">
      {%- paginate collection.products by 24 -%}
        {%- for product in collection.products -%}
          {% render 'hokuno-product-card', product: product %}
        {%- else -%}
          <p style="color: var(--hk-gray); grid-column: 1/-1; text-align: center; padding: 48px 0;">
            Aucun produit dans cette collection.
          </p>
        {%- endfor -%}

        {%- if paginate.pages > 1 -%}
          <nav class="hk-pagination" style="grid-column: 1/-1;" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="hk-page-btn" aria-label="Page précédente">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
              </a>
            {%- endif -%}

            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="hk-page-btn">{{ part.title }}</a>
              {%- else -%}
                <span class="hk-page-btn active" aria-current="page">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}

            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="hk-page-btn" aria-label="Page suivante">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    </div>

  </div>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ collection.title | json }},
  "description": {{ collection.description | strip_html | json }},
  "url": "{{ shop.url }}{{ collection.url }}"
}
</script>

{% schema %}
{
  "name": "Hokuno Collection Main",
  "settings": [],
  "presets": [{ "name": "Hokuno Collection Main" }]
}
{% endschema %}
