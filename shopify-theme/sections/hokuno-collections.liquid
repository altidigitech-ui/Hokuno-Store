<section class="hk-section hk-collections">
  <div class="hk-container">

    <div class="hk-collections-header hk-reveal">
      <span class="hk-label">{{ section.settings.overline | default: 'Collections' }}</span>
      <h2 class="hk-heading-xl">{{ section.settings.title | default: 'EXPLOREZ NOS UNIVERS' }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p style="color: var(--hk-gray); font-size: 0.95rem; max-width: 500px; margin: 12px auto 0; line-height: 1.6;">
          {{ section.settings.subtitle }}
        </p>
      {%- endif -%}
    </div>

    <div class="hk-collections-grid">
      {%- for block in section.blocks -%}
        {%- assign coll_handle = block.settings.collection -%}
        {%- assign coll = collections[coll_handle] -%}
        <a
          href="{{ coll.url | default: '#' }}"
          class="hk-coll-card hk-reveal"
          {{ block.shopify_attributes }}
          aria-label="{{ block.settings.title }}"
        >
          {%- if coll.image -%}
            <img
              class="hk-coll-card-img"
              src="{{ coll.image | image_url: width: 800 }}"
              alt="{{ coll.title | escape }}"
              width="800"
              height="600"
              loading="lazy"
            >
          {%- elsif block.settings.image != blank -%}
            <img
              class="hk-coll-card-img"
              src="{{ block.settings.image | image_url: width: 800 }}"
              alt="{{ block.settings.title | escape }}"
              width="800"
              height="600"
              loading="lazy"
            >
          {%- else -%}
            <div class="hk-coll-card-img" style="background: var(--hk-glass-bg);"></div>
          {%- endif -%}

          <div class="hk-coll-card-overlay"></div>

          <div class="hk-coll-card-body">
            {%- if block.settings.tag != blank -%}
              <span class="hk-coll-card-tag">{{ block.settings.tag }}</span>
            {%- endif -%}
            <h3 class="hk-coll-card-title">{{ block.settings.title | default: coll.title }}</h3>
            <p class="hk-coll-card-desc">{{ block.settings.description }}</p>
            <span class="hk-coll-card-link">
              {{ block.settings.link_text | default: 'Découvrir' }}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14m-7-7 7 7-7 7"/>
              </svg>
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hokuno Collections",
  "settings": [
    { "type": "text", "id": "overline", "label": "Surtitre", "default": "Collections" },
    { "type": "text", "id": "title", "label": "Titre", "default": "EXPLOREZ NOS UNIVERS" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre" }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Carte collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (si pas d'image collection)" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Collection" },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "link_text", "label": "Texte du lien", "default": "Découvrir →" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Hokuno Collections",
      "blocks": [
        { "type": "collection_card", "settings": { "tag": "46 personnages", "title": "WANTED", "description": "Des primes qui courent depuis 12 ans. Portraits en sérigraphie de légende." } },
        { "type": "collection_card", "settings": { "tag": "10 personnages", "title": "DIRECTION", "description": "Pour ceux qui avancent sans boussole. Le cap, c'est l'état d'esprit." } },
        { "type": "collection_card", "settings": { "tag": "10 mythes", "title": "MYTHOLOGIE", "description": "Des dieux, des démons, des forces primales. L'épique à porter sur soi." } },
        { "type": "collection_card", "settings": { "tag": "Design original", "title": "DESIGN HOKUNO", "description": "Le logo Ø et ses déclinaisons. L'identité brute de la marque." } }
      ]
    }
  ]
}
{% endschema %}
