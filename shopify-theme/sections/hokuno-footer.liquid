<footer class="hk-footer" role="contentinfo">
  <div class="hk-container">
    <div class="hk-footer-grid">

      <div class="hk-footer-brand">
        <a href="{{ routes.root_url }}" class="hk-logo" aria-label="Hokuno">
          <div class="hk-logo-mark">Ø</div>
          <span class="hk-logo-name">HOKUNO</span>
        </a>
        <p>{{ section.settings.brand_text | default: "Streetwear manga premium. Chaque design raconte une légende. Collections Wanted, Direction, Mythologie et Design Hokuno." }}</p>
        <div class="hk-footer-social">
          {%- if section.settings.instagram != blank -%}
            <a href="{{ section.settings.instagram }}" class="hk-social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok != blank -%}
            <a href="{{ section.settings.tiktok }}" class="hk-social-link" aria-label="TikTok" target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.87a8.16 8.16 0 004.77 1.52V7.01a4.85 4.85 0 01-1-.32z"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="hk-footer-col">
        <h4>Collections</h4>
        <ul class="hk-footer-links">
          <li><a href="/collections/wanted">Wanted</a></li>
          <li><a href="/collections/direction">Direction</a></li>
          <li><a href="/collections/mythologie">Mythologie</a></li>
          <li><a href="/collections/design-hokuno">Design Hokuno</a></li>
          <li><a href="/collections/all">Tout voir</a></li>
        </ul>
      </div>

      <div class="hk-footer-col">
        <h4>Aide</h4>
        <ul class="hk-footer-links">
          <li><a href="/pages/livraison">Livraison</a></li>
          <li><a href="/pages/retours">Retours</a></li>
          <li><a href="/pages/guide-des-tailles">Guide des tailles</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/contact">Contact</a></li>
        </ul>
      </div>

      <div class="hk-footer-col hk-footer-newsletter">
        <h4>Newsletter</h4>
        <p style="font-size: 0.82rem; color: var(--hk-gray); line-height: 1.6; margin: 0 0 0;">
          {{ section.settings.newsletter_text | default: "Nouvelles collections, drops exclusifs — sois le premier informé." }}
        </p>
        <form class="hk-newsletter-form" action="{{ routes.root_url }}{% if request.locale.iso_code != shop.primary_locale.iso_code %}/{{ request.locale.iso_code }}{% endif %}/contact#contact_form" method="post" accept-charset="UTF-8">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            class="hk-newsletter-input"
            type="email"
            name="contact[email]"
            placeholder="ton@email.com"
            required
            aria-label="Adresse email"
          >
          <button type="submit" class="hk-newsletter-btn">OK</button>
        </form>
      </div>

    </div>

    <div class="hk-footer-bottom">
      <div class="hk-footer-legal">
        <a href="/policies/privacy-policy">Confidentialité</a>
        <a href="/policies/terms-of-service">CGV</a>
        <a href="/policies/refund-policy">Remboursements</a>
        <a href="/pages/llms-txt">llms.txt</a>
      </div>
      <span class="hk-footer-copy">© {{ 'now' | date: '%Y' }} Hokuno — ホクノ</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Hokuno Footer",
  "settings": [
    { "type": "textarea", "id": "brand_text", "label": "Texte marque" },
    { "type": "text", "id": "instagram", "label": "URL Instagram" },
    { "type": "text", "id": "tiktok", "label": "URL TikTok" },
    { "type": "text", "id": "newsletter_text", "label": "Texte newsletter" }
  ],
  "presets": [{ "name": "Hokuno Footer" }]
}
{% endschema %}
