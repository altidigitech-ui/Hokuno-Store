<section class="hk-hero" id="hk-hero">
  <div class="hk-hero-bg" aria-hidden="true"></div>
  <div class="hk-hero-grid" aria-hidden="true"></div>

  <div class="hk-hero-content">
    <div class="hk-hero-text">
      <p class="hk-hero-overline hk-fade-up">{{ section.settings.overline | default: 'Streetwear Manga' }}</p>

      <h1 class="hk-hero-title hk-fade-up hk-fade-up-1">
        {{ section.settings.title | default: 'TOUJOURS ALLER DE L'AVANT' }}
      </h1>

      <p class="hk-hero-title-jp hk-kanji hk-fade-up hk-fade-up-2">
        {{ section.settings.title_jp | default: 'ホクノ' }}
      </p>

      <p class="hk-hero-sub hk-fade-up hk-fade-up-3">
        {{ section.settings.subtitle | default: "Chaque design raconte une légende. Streetwear manga premium, éditions limitées." }}
      </p>

      <div class="hk-hero-ctas hk-fade-up hk-fade-up-4">
        <a href="{{ section.settings.cta_1_url | default: '/collections/all' }}" class="hk-btn hk-btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14m-7-7 7 7-7 7"/>
          </svg>
          {{ section.settings.cta_1_text | default: 'Découvrir la collection' }}
        </a>
        <a href="{{ section.settings.cta_2_url | default: '/collections/all' }}" class="hk-btn hk-btn-outline">
          {{ section.settings.cta_2_text | default: 'Nouveautés' }}
        </a>
      </div>

      <div class="hk-hero-trust" aria-label="Garanties Hokuno">
        <div class="hk-trust">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          Livraison internationale
        </div>
        <div class="hk-trust">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.14"/>
          </svg>
          Retours faciles
        </div>
        <div class="hk-trust">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>
          </svg>
          Paiements sécurisés
        </div>
      </div>
    </div>

    <div class="hk-hero-visual" aria-hidden="true">
      <div class="hk-hero-glow"></div>
      <div class="hk-hero-product">
        {%- if section.settings.hero_product != blank -%}
          {%- assign prod = section.settings.hero_product -%}
          <img
            src="{{ prod.featured_image | image_url: width: 500 }}"
            alt="{{ prod.title | escape }}"
            width="380"
            height="475"
            loading="eager"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'hk-placeholder-img' }}
        {%- endif -%}
      </div>

      {%- if section.settings.hero_collection != blank -%}
        {%- assign coll = collections[section.settings.hero_collection] -%}
        {%- if coll.products.size > 1 -%}
          <div class="hk-hero-thumbs">
            {%- for p in coll.products limit: 4 -%}
              <img
                class="hk-thumb{% if forloop.first %} active{% endif %}"
                src="{{ p.featured_image | image_url: width: 120 }}"
                alt="{{ p.title | escape }}"
                width="56"
                height="56"
                loading="lazy"
              >
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hokuno Hero",
  "settings": [
    { "type": "text", "id": "overline", "label": "Surtitre", "default": "Streetwear Manga" },
    { "type": "text", "id": "title", "label": "Titre principal", "default": "TOUJOURS ALLER DE L'AVANT" },
    { "type": "text", "id": "title_jp", "label": "Titre japonais", "default": "ホクノ" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Chaque design raconte une légende. Streetwear manga premium, éditions limitées." },
    { "type": "product", "id": "hero_product", "label": "Produit hero" },
    { "type": "collection", "id": "hero_collection", "label": "Collection pour les vignettes" },
    { "type": "text", "id": "cta_1_text", "label": "Bouton 1 texte", "default": "Découvrir la collection" },
    { "type": "url", "id": "cta_1_url", "label": "Bouton 1 lien" },
    { "type": "text", "id": "cta_2_text", "label": "Bouton 2 texte", "default": "Nouveautés" },
    { "type": "url", "id": "cta_2_url", "label": "Bouton 2 lien" }
  ],
  "presets": [{ "name": "Hokuno Hero" }]
}
{% endschema %}
