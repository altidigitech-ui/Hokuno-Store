<article class="hk-product" itemscope itemtype="https://schema.org/Product">
  <div class="hk-container">

    <nav class="hk-product-breadcrumb" aria-label="Fil d'Ariane">
      <a href="{{ routes.root_url }}">Accueil</a>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      {%- if product.collections.first -%}
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      {%- endif -%}
      <span style="color: var(--hk-white);">{{ product.title }}</span>
    </nav>

    <div class="hk-product-layout">

      <!-- Gallery -->
      <div class="hk-gallery">
        <div class="hk-gallery-main">
          {%- if product.images.size > 0 -%}
            <img
              itemprop="image"
              src="{{ product.featured_image | image_url: width: 900 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              width="900"
              height="1125"
              loading="eager"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
          {%- if product.images.size > 1 -%}
            <div class="hk-gallery-nav">
              <span class="hk-nav-cur">01</span>
              <span style="color: var(--hk-gray);">/</span>
              <span>{{ product.images.size | prepend: '0' | slice: -2, 2 }}</span>
            </div>
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="hk-gallery-thumbs" role="list" aria-label="Images du produit">
            {%- for image in product.images limit: 8 -%}
              <div class="hk-gallery-thumb{% if forloop.first %} active{% endif %}" role="listitem">
                <img
                  src="{{ image | image_url: width: 200 }}"
                  alt="{{ image.alt | default: product.title | escape }}"
                  width="70"
                  height="70"
                  loading="lazy"
                >
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Info -->
      <div class="hk-product-info">
        {%- if product.collections.first -%}
          <p class="hk-product-collection">{{ product.collections.first.title }}</p>
        {%- endif -%}

        <h1 class="hk-product-title" itemprop="name">{{ product.title }}</h1>

        <div class="hk-product-price-wrap" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
          <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
          <meta itemprop="price" content="{{ product.price | divided_by: 100.0 }}">
          <meta itemprop="availability" content="{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}">
          <span class="hk-product-price">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            <span class="hk-product-price-compare">{{ product.compare_at_price | money }}</span>
          {%- endif -%}
        </div>

        <div class="hk-product-stars" aria-label="Note: 5 étoiles">
          {%- for i in (1..5) -%}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          {%- endfor -%}
          <span style="margin-left: 4px;">(5.0)</span>
        </div>

        <div class="hk-product-badges">
          <span class="hk-badge">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Livraison monde
          </span>
          <span class="hk-badge">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.14"/></svg>
            Retours 30j
          </span>
          <span class="hk-badge">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Qualité premium
          </span>
        </div>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="hk-size-section">
              <div class="hk-size-label">
                <span>{{ option.name }}</span>
                {%- if option.name == 'Size' or option.name == 'Taille' -%}
                  <a href="/pages/guide-des-tailles">Guide des tailles</a>
                {%- endif -%}
              </div>
              <div class="hk-size-grid" role="radiogroup" aria-label="{{ option.name }}">
                {%- for value in option.values -%}
                  <button
                    class="hk-size-btn{% if option.selected_value == value %} selected{% endif %}"
                    type="button"
                    aria-label="{{ option.name }}: {{ value }}"
                    {% if option.selected_value == value %}aria-pressed="true"{% endif %}
                  >
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="hk-product-actions">
          {%- form 'product', product, id: 'hk-product-form', novalidate: 'novalidate' -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button
              type="submit"
              class="hk-atc-btn"
              {%- unless product.available -%}disabled{%- endunless -%}
              aria-label="Ajouter au panier"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
              </svg>
              {%- if product.available -%}
                Ajouter au panier
              {%- else -%}
                Épuisé
              {%- endif -%}
            </button>
          {%- endform -%}

          <button class="hk-wish-btn" type="button" aria-label="Ajouter aux favoris">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </button>
        </div>

        <!-- Backstory -->
        {%- if product.description != blank -%}
          <div class="hk-backstory">
            <div class="hk-backstory-header">
              <span class="hk-label">Backstory</span>
              <span class="hk-backstory-kanji hk-kanji" aria-hidden="true">伝説</span>
            </div>
            <div class="hk-backstory-text" itemprop="description">
              {{ product.description }}
            </div>
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Hokuno Product Main",
  "settings": [],
  "presets": [{ "name": "Hokuno Product Main" }]
}
{% endschema %}
