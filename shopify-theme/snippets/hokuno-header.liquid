<header class="hk-header" role="banner">
  <div class="hk-header-inner">

    <a href="{{ routes.root_url }}" class="hk-logo" aria-label="Hokuno">
      <div class="hk-logo-mark">Ø</div>
      <span class="hk-logo-name">HOKUNO</span>
    </a>

    <nav aria-label="Navigation principale">
      <ul class="hk-nav" role="list">
        <li><a href="/collections/wanted">Wanted</a></li>
        <li><a href="/collections/direction">Direction</a></li>
        <li><a href="/collections/mythologie">Mythologie</a></li>
        <li><a href="/collections/design-hokuno">Design Hokuno</a></li>
      </ul>
    </nav>

    <div class="hk-header-actions">
      <button class="hk-header-lang" data-lang="fr" aria-label="Français">FR</button>
      <span style="color: var(--hk-border); font-size:0.7rem;">/</span>
      <button class="hk-header-lang" data-lang="en" aria-label="English">EN</button>

      <a href="{{ routes.search_url }}" class="hk-icon-btn" aria-label="Rechercher">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </a>

      <a href="{{ routes.account_url }}" class="hk-icon-btn" aria-label="Mon compte">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
        </svg>
      </a>

      <a href="{{ routes.cart_url }}" class="hk-icon-btn" aria-label="Panier ({{ cart.item_count }} articles)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="hk-cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>

      <button class="hk-burger" aria-label="Menu" aria-expanded="false" aria-controls="hk-mobile-menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<div id="hk-mobile-menu" class="hk-mobile-menu" role="dialog" aria-label="Menu mobile" aria-modal="true">
  <a href="/collections/wanted" class="hk-mobile-nav-link">Wanted</a>
  <a href="/collections/direction" class="hk-mobile-nav-link">Direction</a>
  <a href="/collections/mythologie" class="hk-mobile-nav-link">Mythologie</a>
  <a href="/collections/design-hokuno" class="hk-mobile-nav-link">Design Hokuno</a>
  <a href="{{ routes.search_url }}" class="hk-mobile-nav-link" style="font-size:1rem; color: var(--hk-gray-light);">Rechercher</a>
  <a href="{{ routes.account_url }}" class="hk-mobile-nav-link" style="font-size:1rem; color: var(--hk-gray-light);">Mon compte</a>
  <a href="{{ routes.cart_url }}" class="hk-mobile-nav-link" style="font-size:1rem; color: var(--hk-gray-light);">Panier ({{ cart.item_count }})</a>
  <div style="margin-top: auto; display: flex; gap: 16px; padding-top: 32px; border-top: 1px solid var(--hk-border);">
    <button class="hk-header-lang" data-lang="fr">FR</button>
    <span style="color: var(--hk-gray);">/</span>
    <button class="hk-header-lang" data-lang="en">EN</button>
  </div>
</div>
