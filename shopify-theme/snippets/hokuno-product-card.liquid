{%- comment -%} Usage: {% render 'hokuno-product-card', product: product %} {%- endcomment -%}

{%- assign card_product = product -%}
{%- assign card_image = card_product.featured_image -%}
{%- assign card_price = card_product.price | money -%}
{%- assign card_compare = card_product.compare_at_price -%}

{%- assign card_collection = card_product.collections.first -%}

<a href="{{ card_product.url }}" class="hk-product-card" aria-label="{{ card_product.title | escape }}">
  <div class="hk-product-card-img-wrap">
    {%- if card_image -%}
      <img
        class="hk-product-card-img"
        src="{{ card_image | image_url: width: 600 }}"
        alt="{{ card_image.alt | default: card_product.title | escape }}"
        width="600"
        height="750"
        loading="lazy"
      >
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'hk-product-card-img' }}
    {%- endif -%}

    {%- if card_product.available == false -%}
      <span class="hk-product-card-badge">Épuisé</span>
    {%- elsif card_product.compare_at_price > card_product.price -%}
      <span class="hk-product-card-badge">Promo</span>
    {%- endif -%}

    <button class="hk-product-card-wish" aria-label="Ajouter aux favoris" type="button">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
    </button>
  </div>

  <div class="hk-product-card-body">
    {%- if card_collection -%}
      <span class="hk-product-card-coll">{{ card_collection.title }}</span>
    {%- endif -%}
    <h3 class="hk-product-card-title">{{ card_product.title }}</h3>
    <div>
      <span class="hk-product-card-price">{{ card_price }}</span>
      {%- if card_compare > card_product.price -%}
        <span class="hk-product-card-price-compare">{{ card_compare | money }}</span>
      {%- endif -%}
    </div>
  </div>
</a>
