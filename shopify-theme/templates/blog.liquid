<!-- templates/blog.liquid — Blog / Journal -->
<div class="page-wrap">
  {% render 'breadcrumbs' %}
  <h1 class="page-title">{{ blog.title }}</h1>

  {% if blog.articles_count > 0 %}
    <div class="blog-grid">
      {% for article in blog.articles %}
        <a href="{{ article.url }}" class="blog-card">
          {% if article.image %}
            <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title }}" class="blog-card-img" width="600" height="200" loading="lazy">
          {% endif %}
          <div class="blog-card-info">
            <time class="blog-date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: "%d %B %Y" }}</time>
            <h3 class="blog-card-title">{{ article.title }}</h3>
            <p class="blog-card-excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
            <span class="blog-read">{{ 'blog.read_more' | t }} →</span>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <p class="blog-empty">{{ 'blog.empty' | t }}</p>
  {% endif %}
</div>
