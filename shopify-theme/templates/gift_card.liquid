<!-- templates/gift_card.liquid — Carte cadeau (standalone) -->
<!DOCTYPE html>
<html lang="{{ request.locale.iso_code | default: 'fr' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ 'gift_cards.title' | t }} — HOKUNO ホクノ</title>
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap">
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{background:#000;color:#fff;font-family:'Inter',sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh}
    .gc-wrap{text-align:center;max-width:420px;padding:48px 32px}
    .gc-logo{height:48px;margin-bottom:32px;filter:brightness(1.2);mix-blend-mode:screen}
    .gc-title{font-size:14px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,0.5)}
    .gc-amount{font-size:52px;font-weight:900;color:#D4A853;margin:24px 0}
    .gc-code{font-size:18px;letter-spacing:4px;background:rgba(255,255,255,0.04);padding:20px;border-radius:8px;border:1px solid rgba(255,255,255,0.1);margin:24px 0;font-weight:600}
    .gc-expiry{color:rgba(255,255,255,0.4);font-size:13px;margin-bottom:32px}
    .gc-shop{display:inline-block;background:#D4A853;color:#000;padding:16px 32px;font-weight:700;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;border-radius:4px;text-decoration:none;transition:background .3s}
    .gc-shop:hover{background:#c49a3d}
  </style>
</head>
<body>
  <div class="gc-wrap">
    <img class="gc-logo" src="{{ 'logo-hokuno-transparent.png' | asset_url }}" alt="HOKUNO">
    <p class="gc-title">{{ 'gift_cards.title' | t }}</p>
    <p class="gc-amount">{{ gift_card.balance | money }}</p>
    <p class="gc-code">{{ gift_card.code | format_code }}</p>
    <p class="gc-expiry">
      {% if gift_card.expires_on %}
        {{ 'gift_cards.expires' | t }}: {{ gift_card.expires_on | date: "%d/%m/%Y" }}
      {% else %}
        {{ 'gift_cards.no_expiry' | t }}
      {% endif %}
    </p>
    <a href="{{ shop.url }}" class="gc-shop">{{ 'gift_cards.shop_now' | t }}</a>
  </div>
</body>
</html>
