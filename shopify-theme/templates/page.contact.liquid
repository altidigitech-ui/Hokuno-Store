<!-- templates/page.contact.liquid — Page contact avec formulaire Liquid -->
<div class="page-wrap">
  {% render 'breadcrumbs' %}

  <div class="contact-wrap">
    <div class="contact-info">
      <h1 class="page-title">Contact</h1>
      <p class="contact-intro">Une question, une suggestion, une collaboration ? On vous répond sous 24-48h.</p>
      <p class="contact-email">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        <a href="mailto:altidigitech@gmail.com">altidigitech@gmail.com</a>
      </p>
    </div>

    <div class="contact-form-wrap">
      {% form 'contact', id: 'contact-form' %}
        {% if form.posted_successfully? %}
          <p class="form-success">{{ 'contact.success' | t }}</p>
        {% endif %}

        {% if form.errors %}
          <div class="form-error">{{ form.errors | default_errors }}</div>
        {% endif %}

        <label for="contact-name" class="form-label">{{ 'contact.name' | t }}</label>
        <input type="text" id="contact-name" name="contact[name]" class="form-input" required autocomplete="name">

        <label for="contact-email" class="form-label">{{ 'contact.email' | t }}</label>
        <input type="email" id="contact-email" name="contact[email]" class="form-input" required autocomplete="email">

        <label for="contact-message" class="form-label">{{ 'contact.message' | t }}</label>
        <textarea id="contact-message" name="contact[body]" class="form-input form-textarea" rows="6" required></textarea>

        <button type="submit" class="btn-gold contact-submit">{{ 'contact.send' | t }}</button>
      {% endform %}
    </div>
  </div>
</div>
